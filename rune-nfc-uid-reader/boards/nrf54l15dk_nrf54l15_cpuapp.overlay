/*
 * Default wiring: MFRC522 ("RC522") reader on SPI21.
 *
 *   RC522 pin   ->  nRF54L15 DK pin
 *   SDA (=CS)   ->  P1.14
 *   SCK         ->  P1.11
 *   MOSI        ->  P1.12
 *   MISO        ->  P1.13   (shared with Button 0: don't press Button 0)
 *   RST         ->  VDD (3.3 V)  (just keep the chip out of reset)
 *   3.3V        ->  VDD
 *   GND         ->  GND
 *   IRQ         ->  not connected
 *
 * IMPORTANT: set the DK's VDD to 3.3 V in nRF Connect "Board Configurator"
 * first. The RC522 cannot see 1.8 V logic.
 */

/ {
	zephyr,user {
		rc522-cs-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>,
				<NRF_PSEL(SPIM_MISO, 1, 13)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>,
				<NRF_PSEL(SPIM_MISO, 1, 13)>;
			low-power-enable;
		};
	};
};

&spi21 {
	status = "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";
};
